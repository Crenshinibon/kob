{
	"name": "kob",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "bun@1.3.9",
	"scripts": {
		"dev": "export ORIGIN=http://localhost:5173 && vite dev",
		"build": "bun run db:push && vite build",
		"preview": "vite preview",
		"prepare": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"playwright": "playwright test",
		"test": "bun run test:unit && bun run test:e2e",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:push": "bun scripts/db-push.ts",
		"db:cleanup-neon-branches": "bun scripts/cleanup-neon-branches.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "bunx @better-auth/cli generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes",
		"db:wipe": "bun scripts/wipe-tournaments.ts",
		"db:cleanup": "bun scripts/cleanup-old-tournaments.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.1",
		"@sveltejs/kit": "^2.70.4",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/bun": "^1.4.4",
		"@types/node": "^26.6.6",
		"@types/qrcode": "^1.5.6",
		"better-auth": "^1.7.25",
		"dotenv": "^18.0.10",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"esbuild": "^0.28.2",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"postgres": "^4.1.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@inlang/paraglide-js": "^2.29.3",
		"@neondatabase/serverless": "^1.2.1",
		"@sveltejs/adapter-vercel": "^6.3.5",
		"qrcode": "^1.5.4",
		"valibot": "^1.5.0"
	},
	"trustedDependencies": [
		"esbuild"
	]
}
